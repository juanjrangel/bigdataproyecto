# Copiar a .env y ajustar. Ningún valor es secreto; JUPYTER_TOKEN sí debe cambiarse si se expone la red.
PIPELINE_YEAR=2025
# Meses a procesar: "1-12" (año completo) o "1" (modo demo rápido)
PIPELINE_MONTHS=1-12
SPARK_MASTER=spark://spark-master:7077
SPARK_SHUFFLE_PARTITIONS=144
SPARK_WORKER_CORES=6
SPARK_WORKER_MEMORY=5g
MODEL_SAMPLE_FRACTION=0.05
GBT_MAX_ITER=40
GBT_MAX_DEPTH=8
SAMPLE_ROWS=50
JUPYTER_TOKEN=bigdata
